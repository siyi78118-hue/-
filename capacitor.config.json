{
  "appId": "com.siyi.al",
  "appName": "AL",
  "webDir": "tavern-app",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#ededed"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["sound", "alert", "banner", "list"]
    },
    "BackgroundRunner": {
      "label": "com.siyi.al.background",
      "src": "runners/al-background.js",
      "event": "backgroundTick",
      "repeat": false,
      "interval": 15,
      "autoStart": false
    }
  }
}
