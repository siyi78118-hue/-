{
  "cognitionRuntime": {
    "presetVersion": "2.0.0",
    "softDeadlineMs": 60000,
    "hardDeadlineMs": 300000,
    "rolloutBootstrap": {
      "schemaVersion": 1,
      "defaultMode": "legacy",
      "defaultPhase": "stable"
    }
  },
  "host": "0.0.0.0",
  "port": 17891,
  "pairingSecret": "replace-with-a-long-random-pairing-secret",
  "databasePath": "data/yuqi-runtime.sqlite",
  "codexCommand": "codex",
  "codexArgs": ["app-server"],
  "codexRuntimeDirectory": ".",
  "roleProfiles": {
    "fast": {
      "memory": { "model": "gpt-5.6-terra", "effort": "medium" },
      "brain": { "model": "gpt-5.6-sol", "effort": "medium" },
      "supervisor": null
    },
    "deep": {
      "memory": { "model": "gpt-5.6-sol", "effort": "medium" },
      "brain": { "model": "gpt-5.6-sol", "effort": "medium" },
      "supervisor": { "model": "gpt-5.6-terra", "effort": "medium" }
    }
  },
  "cloudRelay": {
    "enabled": false,
    "url": "https://al-cloud-timer.example.workers.dev",
    "deviceId": "replace-with-device-id",
    "deviceToken": "replace-with-a-long-random-device-token",
    "encryptionKeyBase64": "replace-with-a-random-32-byte-base64-key",
    "pollIntervalMs": 1500,
    "proxy": {
      "enabled": false,
      "url": "http://127.0.0.1:10809",
      "noProxy": "127.0.0.1,localhost,::1"
    }
  }
}
