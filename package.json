{
  "scripts": {
    "presets:sync": "node scripts/sync-yuqi-preset-assets.mjs",
    "presets:check": "npm run cognition:check && node scripts/sync-yuqi-preset-assets.mjs --check",
    "cognition:sync": "node scripts/compile-yuqi-cognition-assets.mjs",
    "cognition:check": "node scripts/compile-yuqi-cognition-assets.mjs --check",
    "cognition:matrix": "node --test tests/yuqi-cognition-feature-matrix.test.mjs",
    "cognition:replay": "node scripts/run-yuqi-cognition-replay.mjs",
    "cognition:replay-report": "node scripts/report-yuqi-cognition-replay.mjs",
    "cognition:quality:check": "node scripts/compile-yuqi-lived-quality-scenes.mjs --check",
    "cognition:quality:replay": "node scripts/run-yuqi-lived-quality-replay.mjs",
    "cognition:quality:report": "node scripts/report-yuqi-lived-quality.mjs",
    "cognition:promotion-check": "node scripts/cognition-rollout.mjs check",
    "cognition:promote": "node scripts/cognition-rollout.mjs promote",
    "cognition:rollback": "node scripts/cognition-rollout.mjs rollback",
    "cognition:rollout-status": "node scripts/cognition-rollout.mjs status",
    "cognition:v3:races": "node scripts/verify-yuqi-v3-races.mjs --out artifacts/yuqi-lived-agency-v3/race-report.json",
    "cognition:v3:readiness-inputs": "node scripts/generate-yuqi-v3-readiness-inputs.mjs --evidence-dir artifacts/yuqi-lived-agency-v3 --config yuqi-runtime/config.json",
    "cognition:v3:visible-path-metrics": "node scripts/generate-yuqi-visible-path-metrics.mjs --android-export artifacts/yuqi-lived-agency-v3/private/visible-path-android.jsonl --pc-export artifacts/yuqi-lived-agency-v3/private/visible-path-pc.jsonl --out artifacts/yuqi-lived-agency-v3/visible-path-metrics.json",
    "cognition:v3:visible-path:formal": "node scripts/run-yuqi-visible-path-formal.mjs",
    "cognition:v3:readiness": "node scripts/verify-yuqi-v3-readiness.mjs",
    "start": "node serve-static.mjs",
    "test": "npm run cognition:matrix && npm run presets:check && node --test tests/rp-preset-contract.test.mjs && node --test tests/android-unsigned-release-contract.test.mjs tests/role-plan-domain.test.mjs tests/role-plan-repository.test.mjs tests/cloud-timer-d1.test.mjs tests/yuqi-relay-worker.test.mjs tests/yuqi-ui-contract.test.mjs tests/yuqi-deployment-contract.test.mjs tests/payment-batch-bridge-contract.test.mjs tests/yuqi-memory-backup.test.mjs tests/yuqi-memory-lifecycle.test.mjs && node --test yuqi-runtime/test/*.test.mjs && node test-basic.mjs && node test-sw-automatic-task-guard.mjs",
    "android:sync": "npm run presets:sync && cap sync android",
    "android:copy": "npm run presets:sync && cap copy android",
    "android:open": "cap open android",
    "android:network": "node scripts/generate-yuqi-network-policy.mjs",
    "android:debug": "npm run presets:sync && node scripts/generate-yuqi-network-policy.mjs && cap sync android && cd android && gradlew.bat assembleDebug --no-problems-report",
    "cloud:deploy": "node scripts/deploy-cloud-timer.mjs",
    "cloud:deploy:raw": "node scripts/run-wrangler.mjs deploy",
    "cloud:health": "node scripts/check-cloud-timer.mjs",
    "cloud:relay:test": "node --test tests/yuqi-relay-worker.test.mjs",
    "cloud:relay:deploy": "node scripts/run-wrangler.mjs deploy --config wrangler.yuqi-relay.toml",
    "yuqi:setup": "node scripts/setup-yuqi-runtime.mjs",
    "yuqi:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-yuqi-background.ps1",
    "yuqi:lan:enable": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/enable-yuqi-lan-firewall.ps1",
    "yuqi:backup": "node scripts/backup-yuqi-memory.mjs yuqi-runtime/config.json",
    "yuqi:verify": "node scripts/verify-yuqi-runtime.mjs",
    "yuqi:cloud:deploy": "node scripts/deploy-yuqi-cloud.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.108.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1"
  }
}
